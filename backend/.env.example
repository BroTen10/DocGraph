# ============ 应用配置 ============
APP_HOST=0.0.0.0
APP_PORT=8800
APP_DEBUG=true
# 上传文件根目录（按合同号自动建子目录隔离）
UPLOAD_ROOT=./uploads
# 单文件最大尺寸（MB）
MAX_FILE_SIZE_MB=50
# 启动时是否重建数据库：false=幂等建表不丢数据（默认）；
# true=DROP SCHEMA 重建 Postgres 并同步清空 Neo4j（仅 schema 破坏性变更时临时开启）
DB_RESET_ON_STARTUP=false

# ============ Postgres ============
PG_HOST=localhost
PG_PORT=5432
PG_DB=doc_review
PG_USER=postgres
PG_PASSWORD=postgres

# ============ Neo4j ============
# 注意：宿主机 7687 端口被 Windows Hyper-V 保留，容器 Bolt 端口映射到 17687
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# ============ LLM (DeepSeek, OpenAI 兼容) ============
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
# 规则转图谱置信度阈值（>=阈值自动确认，<阈值进入人工确认）
LLM_CONFIDENCE_THRESHOLD=0.9

# ============ OCR (阿里云百炼 - 通义千问多模态) ============
# 百炼 OpenAI 兼容端点
OCR_API_KEY=sk-your-dashscope-key
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OCR_MODEL_NAME=qwen3.7-plus

# ============ 审查配置 ============
# 是否允许收付同日（true=允许 T+0，false=严格收早于付）
ALLOW_SAME_DAY_RECEIVE_PAY=true
# 金额容差百分比
AMOUNT_TOLERANCE_PERCENT=5
# 重量容差（kg）
WEIGHT_TOLERANCE_KG=0.5
